# Copy this file to .env and fill in real values. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_URL=http://localhost:5173

SQLITE_TIMEOUT=20
# Local custom runserver only; Railway's Free deployment uses one Uvicorn worker.
DJANGO_RUNSERVER_WORKERS=4
# Railway sets RAILWAY_VOLUME_MOUNT_PATH when a persistent volume is mounted.
# Optional local/host overrides:
DATABASE_PATH=
MEDIA_ROOT=

# Frontend dev server origin (Vite)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local Redis for WebSocket event delivery across multiple workers.
# On Railway Free, leave REDIS_URL unset to use the one-worker in-memory layer;
# add Redis only if you later scale to multiple backend workers.
REDIS_URL=redis://127.0.0.1:6380/0
